# Copy to .env and fill in.

# Password for adding/removing friends. Set this before exposing the app to the internet.
ADMIN_TOKEN=change-me-to-something-long

# How often to fetch XP from Duolingo (hours).
FETCH_INTERVAL_HOURS=3

# Your time zone, so "Today" resets at your midnight. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/London

# Only needed if you use the Cloudflare Tunnel service in docker-compose.yml.
CLOUDFLARE_TUNNEL_TOKEN=
